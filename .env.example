# Feishu self-built app credentials (Developer Console -> Credentials & Basic Info)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# feishu (open.feishu.cn) or lark (open.larksuite.com)
FEISHU_DOMAIN=feishu
# Optional: bot's own open_id to distinguish @bot from @other-users in groups
FEISHU_BOT_OPEN_ID=

# Ollama reached through the Owner's Cloudflare Tunnel
OLLAMA_URL=https://ollama.example.com

# Optional: read-only GitHub token for private repositories
GITHUB_TOKEN=

# Optional: path to the non-secret config file
CONFIG_PATH=./config.yaml
